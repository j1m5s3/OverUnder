# Oracle tick tunables (code defaults shown; production values are set by deploy-gcp.yml, see infra/gcp/README.md)
# OU_FALLBACK_POLICY=attest                 # attest | arbitrate | manual (ADR-0002 24 h fallback)
# OU_TICK_BUDGET_SECONDS=780                # wall-clock budget per tick (0 = unbounded)
# OU_TICK_SINGLE_FLIGHT=1                   # overlap guard; only active on Cloud Run
# OU_SCOUT_STALE_SECONDS=600
# OU_SCOUT_RECENT_SECONDS=129600            # 36 h
# OU_SCOUT_MAX_AGE_SECONDS=0                # 0 = no cutoff
# OU_RESEARCH_RETRY_SECONDS=21600           # 6 h research cooldown per market
# OU_GENERAL_RESOLVE_MAX_MARKETS=2
# OU_GENERAL_RESOLVE_DELAY_SECONDS=86400    # ungated general markets: 24 h after closeTime
# OU_GENERAL_RESOLVE_GATED_DELAY_SECONDS=3600
# OU_GENERAL_RESOLVE_MIN_CONFIDENCE=0.8
# OU_LISTING_STALE_GRACE_SECONDS=28800      # 8 h
# OU_QUESTION_ID_KEY=                       # optional HMAC key for listing question ids (a secret in production)

# Auth / app
CDP_PROJECT_ID=
