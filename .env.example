MOONPAY_API_KEY=
MOONPAY_SECRET=
KYC_THRESHOLD_USDC=500.0
KYC_RESTRICTED_JURISDICTIONS=
# AUTH_ANVIL_BYPASS=1  # ONLY for local anvil testing (chain_id==31337). Default: off. NEVER enable in production.
# Lifecycle, indexer and relayer (code defaults shown; see infra/gcp/cloudrun.env.example for the full list)
# TRADING_HALT_AT_CLOSE=true                # quotes and POST /orders return 409 at/after closeTime
# INDEXER_ENABLED=true
# INDEXER_START_BLOCK=0                     # 0 on anvil = index from block 1
# INDEXER_LOOKBACK_BLOCKS=43200
# INDEXER_MAX_BLOCK_RANGE=2000
# AMM_QUOTE_RPC_TIMEOUT_SECONDS=5
# PORTFOLIO_RPC_TIMEOUT_SECONDS=10
# OPERATOR_RPC_TIMEOUT_SECONDS=15
# OPERATOR_TX_TIMEOUT_SECONDS=60
# RELAYER_ENABLED=false                     # CLOB order intake (OU-T003); needs RELAYER_PRIVATE_KEY
# RELAYER_WORKER_ENABLED=false              # settlement worker; runs only with RELAYER_ENABLED=true
# RELAYER_LOG_LOOKBACK_BLOCKS=5000
# RELAYER_MAX_OPEN_ORDERS_PER_MAKER=100

