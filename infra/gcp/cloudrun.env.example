# Cloud Run environment variables: OverUnder API (overunder-api) and oracle job (overunder-oracle)
# Values are set by .github/workflows/deploy-gcp.yml. --set-env-vars replaces the whole env list on every
# deploy, so a variable edited in the console is dropped by the next deploy: add overrides to the workflow.
# Never put real values in this file.

# ============================================================================
# API (overunder-api)
# ============================================================================

# === Secrets (Secret Manager, mapped with --set-secrets; see infra/gcp/README.md for the preflight rules) ===
JWT_SECRET=                        # OU_JWT_SECRET: JWT signing key (HS256, 32+ bytes) [REQUIRED]
DATABASE_URL=                      # OU_DATABASE_URL: postgresql+asyncpg://... (never sqlite; preflight enforced) [REQUIRED]
ANVIL_RPC_URL=                     # OU_ANVIL_RPC_URL: Base Sepolia RPC URL (chain_id 84532) [REQUIRED]
CDP_API_KEY_ID=                    # OU_CDP_API_KEY_ID: Coinbase CDP API key id [REQUIRED]
CDP_API_KEY_SECRET=                # OU_CDP_API_KEY_SECRET: Coinbase CDP API key secret, may be a multi-line PEM [REQUIRED]
OPERATOR_PRIVATE_KEY=              # OU_OPERATOR_PRIVATE_KEY: operator EOA key, 32-byte hex (Sepolia only) [REQUIRED]
RELAYER_PRIVATE_KEY=               # OU_RELAYER_PRIVATE_KEY: CLOB settlement + emissions EOA key, 32-byte hex
                                   #   [REQUIRED when RELAYER_ENABLED=true; otherwise mapped only when valid]
MOONPAY_SECRET=                    # OU_MOONPAY_SECRET: MoonPay API secret (optional; mapped only when valid)

# === Set by the workflow (--set-env-vars; repo variables where noted, default shown when unset) ===
CHAIN_ID=84532                     # Base Sepolia chain id
CDP_PROJECT_ID=                    # repo var CDP_PROJECT_ID: Coinbase CDP project id (non-secret)

# Contract addresses (repo variables; must match the live Base Sepolia deployment)
USDC_ADDRESS=                      # Mock USDC ERC-20
CTF_ADDRESS=                       # ConditionalTokens
FACTORY_ADDRESS=                   # MarketFactory (v2 after the deploy-contracts v2 migration)
EXCHANGE_ADDRESS=                  # Exchange (CLOB)
AMM_ADDRESS=                       # MarketAMM (v2 after the deploy-contracts v2 migration)
ORACLE_ADDRESS=                    # ConsensusOracle
FEE_VAULT_ADDRESS=                 # FeeVault
OU_TOKEN_ADDRESS=                  # OU (RevenueToken)
PAYMASTER_ADDRESS=                 # OverUnderPaymaster (leftover; user wallets are CDP, ADR-0010)
ENTRYPOINT_ADDRESS=                # ERC-4337 EntryPoint v0.7 (leftover)
ACCOUNT_FACTORY_ADDRESS=           # SimpleAccountFactory (leftover)
COINBASE_ONRAMP_APP_ID=            # Coinbase Pay app id (stub in MVP)

# Lifecycle (repo variables)
INDEXER_START_BLOCK=0              # First block the indexer reads; set to the deployBlock printed by deploy-contracts
TRADING_HALT_AT_CLOSE=true         # At closeTime: AMM quotes 409, POST /orders 409, no CLOB matching, the relayer
                                   #   worker rolls back fills matched after close; web gets NEXT_PUBLIC_TRADING_HALT_AT_CLOSE
RELAYER_ENABLED=false              # CLOB order intake (OU-T003); true makes OU_RELAYER_PRIVATE_KEY required
RELAYER_WORKER_ENABLED=false       # Relayer settlement worker in the API process (runs only with RELAYER_ENABLED=true)

# === Auto-set by Cloud Run ===
PORT=8080

# === Code defaults (backend/app/config.py). Not passed by the workflow; shown with their defaults ===
# FEE_BPS_TAKER=75                        # CLOB taker fee (basis points)
# FEE_BPS_AMM=100                         # AMM fee (basis points)
# CONSENSUS_WINDOW_SECONDS=86400          # Oracle consensus window (24 h)
# WILDCARD_SEED_USDC=200                  # Wildcard market seed (USDC)
# JWT_TTL_SECONDS=604800                  # JWT lifetime (7 days)
# KYC_THRESHOLD_USDC=500.0
# KYC_RESTRICTED_JURISDICTIONS=
#
# RPC timeouts
# AMM_QUOTE_RPC_TIMEOUT_SECONDS=5         # Public AMM quote RPC timeout (no web3 retries)
# PORTFOLIO_RPC_TIMEOUT_SECONDS=10        # Portfolio positions / fee-vault NAV RPC timeout (no web3 retries)
# OPERATOR_RPC_TIMEOUT_SECONDS=15         # Operator calls (POST /markets, pause)
# OPERATOR_TX_TIMEOUT_SECONDS=60          # Operator receipt wait
#
# Chain indexer (backend/app/indexer/listener.py)
# INDEXER_ENABLED=true
# INDEXER_INTERVAL_SECONDS=5
# INDEXER_LOOKBACK_BLOCKS=43200           # Start this far behind head when INDEXER_START_BLOCK=0 and there is no checkpoint
# INDEXER_MAX_BLOCK_RANGE=2000            # eth_getLogs chunk size (halved after a failed range, then regrows)
# INDEXER_MIN_BLOCK_RANGE=10
# INDEXER_MAX_CHUNKS_PER_TICK=10
# INDEXER_MAX_BACKOFF_SECONDS=300
# INDEXER_RPC_TIMEOUT_SECONDS=10
# INDEXER_LEADER_LOCK_KEY=1330989390      # Postgres advisory lock (0x4F55494E "OUIN"): one instance indexes at a time
#
# CLOB relayer (backend/app/relayer; off unless RELAYER_ENABLED=true)
# RELAYER_POLL_SECONDS=2
# RELAYER_BATCH_SIZE=10
# RELAYER_MAX_ATTEMPTS=5
# RELAYER_RETRY_BACKOFF_SECONDS=15
# RELAYER_RESUBMIT_AFTER_SECONDS=60       # Fee-bump resubmit after this long unmined
# RELAYER_FEE_BUMP_BPS=1250
# RELAYER_MAX_FEE_PER_GAS_WEI=5000000000  # 5 gwei cap (EIP-1559)
# RELAYER_PRIORITY_FEE_WEI=1000000
# RELAYER_GAS_BUFFER_BPS=2000
# RELAYER_GAS_LIMIT_CAP=600000
# RELAYER_CONFIRMATIONS=1
# RELAYER_MIN_EXPIRY_SECONDS=60           # Orders expiring within this window fail preflight
# RELAYER_PREFLIGHT_ON_POST=true
# RELAYER_LEADER_LOCK_KEY=1330991692      # Postgres advisory lock (0x4F55524C "OURL")
# RELAYER_RPC_TIMEOUT_SECONDS=15
# RELAYER_LOG_LOOKBACK_BLOCKS=5000        # OrderFilled log search window when a job has no first_sent_block
# RELAYER_MAX_OPEN_ORDERS_PER_MAKER=100   # POST /orders: open orders one maker may hold

# ============================================================================
# Oracle job (overunder-oracle, Cloud Run Job, scheduler overunder-oracle-tick */15)
# ============================================================================

# === Secrets (Secret Manager) ===
# CURSOR_API_KEY=                  # OU_CURSOR_API_KEY [REQUIRED]
# CURSOR_SEARCH_MCP_URL=           # OU_CURSOR_SEARCH_MCP_URL, http(s) URL [REQUIRED]
# JWT_SECRET=                      # OU_JWT_SECRET [REQUIRED]
# OPERATOR_PRIVATE_KEY=            # OU_OPERATOR_PRIVATE_KEY [REQUIRED]
# AGENT_ALPHA_KEY=                 # OU_AGENT_ALPHA_KEY [REQUIRED]
# AGENT_BETA_KEY=                  # OU_AGENT_BETA_KEY [REQUIRED]
# AGENT_GAMMA_KEY=                 # OU_AGENT_GAMMA_KEY [REQUIRED]
# ANVIL_RPC_URL=                   # OU_ANVIL_RPC_URL [REQUIRED]
# OU_QUESTION_ID_KEY=              # OU_QUESTION_ID_KEY (optional, one line): HMAC key for listing question ids so
#                                  #   they cannot be precomputed and squatted; unset = public sha256. Keep it stable.

# === Always set by the workflow ===
# OU_API_URL=                      # The deployed API URL
# CHAIN_ID=84532
# ORACLE_ADDRESS=                  # repo var ORACLE_ADDRESS
# OU_CURSOR_RUNTIME=local          # repo var; local = cursor-sdk agents in the container, MCP tools only; cloud = Cursor cloud agents
# OU_FALLBACK_POLICY=attest        # repo var; attest | arbitrate | manual (ADR-0002 24 h fallback)
# OU_TICK_BUDGET_SECONDS=780       # repo var, 1-780; the job's task timeout is this + 60 s (840 s by default)

# === Set only when the repo variable exists (otherwise the oracles code default below applies) ===
# OU_TICK_SINGLE_FLIGHT=1          # On under Cloud Run; 0 disables the overlap guard (needs run.executions.get/list)
# OU_SEED_USDC=200000000           # Seed per operator-listed market (6-decimal units)
# OU_SCOUT_MAX_MARKETS=5           # Sports primaries scouted per tick
# OU_SCOUT_STALE_SECONDS=600       # Skip a game whose score row was updated within this window
# OU_SCOUT_RECENT_SECONDS=129600   # 36 h: recent games are scouted before the rotating backlog
# OU_SCOUT_MAX_AGE_SECONDS=0       # Opt-in cutoff for old games (0 = off)
# OU_RESOLVE_MAX_MARKETS=3         # Sports primaries resolved per tick
# OU_RESEARCH_RETRY_SECONDS=21600  # 6 h cooldown before re-researching the same market
# OU_RESEARCH_ERROR_RETRY_SECONDS=3600  # 1 h cooldown after a research run that raised (failure marker row)
# OU_RESEARCH_MIN_SECONDS=90       # Do not start a 3-agent research run with less budget than this left
# OU_LISTING_RESERVE_SECONDS=120   # Stages before listing stop this long before the tick deadline (capped at 1/4 of the budget)
# OU_STAGE_SHARE_SCORES=0.4        # Max share of the tick budget per stage, in (0, 1]; also OU_STAGE_SHARE_RESOLVE,
#                                  # OU_STAGE_SHARE_RESOLVE_GENERAL, OU_STAGE_SHARE_SCHEDULE, OU_STAGE_SHARE_LISTING (default 1.0)
# OU_GENERAL_RESOLVE_MAX_MARKETS=2 # Wildcard / user / non-sports markets researched per tick
# OU_GENERAL_RESOLVE_DELAY_SECONDS=86400        # 24 h after closeTime for ungated general markets
# OU_GENERAL_RESOLVE_GATED_DELAY_SECONDS=3600   # 1 h after closeTime for event-gated markets (also need a final score or resolved parent)
# OU_GENERAL_RESOLVE_MIN_CONFIDENCE=0.8         # Per-agent confidence floor (0-1)
# OU_LISTING_STALE_GRACE_SECONDS=28800          # 8 h: stale scheduled/in_progress rows count as done for week-roll listing
# OU_CURSOR_MODEL_ALPHA=composer-2.5
# OU_CURSOR_MODEL_BETA=grok-4.6
# OU_CURSOR_MODEL_GAMMA=gpt-5.1

# === Set by Cloud Run ===
# CLOUD_RUN_JOB, CLOUD_RUN_EXECUTION  # Turn on the tick single-flight guard (oracles/tick_lease.py)
