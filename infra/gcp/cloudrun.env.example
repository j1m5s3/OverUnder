# Cloud Run Environment Variables — OverUnder API
# This file documents required environment variables for the overunder-api service.
# Values are set via GitHub Actions workflow or manual gcloud deployment.

# === Secrets (from Secret Manager) ===
# These are mapped to Cloud Run using --set-secrets flag
JWT_SECRET=                        # JWT signing key (HS256, 32+ bytes) [REQUIRED]
DATABASE_URL=                      # PostgreSQL connection string (NOT sqlite; preflight enforced) [REQUIRED]
ANVIL_RPC_URL=                     # Base Sepolia RPC URL (chain_id 84532) [REQUIRED]
CDP_API_KEY_ID=                    # Coinbase CDP API key id [REQUIRED for wallets]
CDP_API_KEY_SECRET=                # Coinbase CDP API key secret [REQUIRED for wallets]
MOONPAY_SECRET=                    # MoonPay API secret
OPERATOR_PRIVATE_KEY=              # EOA private key for market operations (0x-prefixed; Sepolia smoke only)
RELAYER_PRIVATE_KEY=               # EOA private key for CLOB settlement (0x-prefixed; Sepolia smoke only)

# === Non-Secret Environment Variables ===
# These are set via --set-env-vars flag
CHAIN_ID=84532                     # Base Sepolia chain ID (required for production)
CDP_PROJECT_ID=                    # Coinbase CDP project id (non-secret)

# Contract addresses (set after deployment to Base Sepolia)
USDC_ADDRESS=                      # Mock USDC ERC-20 address
CTF_ADDRESS=                       # ConditionalTokens contract address
FACTORY_ADDRESS=                   # MarketFactory contract address
EXCHANGE_ADDRESS=                  # Exchange (CLOB) contract address
AMM_ADDRESS=                       # MarketAMM contract address
ORACLE_ADDRESS=                    # ConsensusOracle contract address
FEE_VAULT_ADDRESS=                 # FeeVault contract address
OU_TOKEN_ADDRESS=                  # OU (RevenueToken) contract address

# Optional ramp provider IDs
COINBASE_ONRAMP_APP_ID=            # Coinbase Pay app ID (stub in MVP)

# === Auto-Set by Cloud Run ===
PORT=8080                          # Cloud Run sets this automatically

# === Defaults (from backend/app/config.py) ===
# These can be overridden if needed
# FEE_BPS_TAKER=75                 # CLOB taker fee basis points (default 75)
# FEE_BPS_AMM=100                  # AMM fee basis points (default 100)
# CONSENSUS_WINDOW_SECONDS=86400   # Oracle consensus window (default 24h)
# WILDCARD_SEED_USDC=200           # Wildcard market seed USDC (default 200)
# JWT_TTL_SECONDS=604800           # JWT expiration (default 7 days)
